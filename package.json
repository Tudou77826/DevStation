{
  "name": "devstation",
  "version": "0.1.0",
  "description": "DevStation - Local AI-assisted development desktop app",
  "author": "DevStation",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "oxlint src scripts",
    "arch:check": "dependency-cruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:terminal": "electron scripts/electron-terminal-smoke.cjs",
    "deps:check": "npm ls --all",
    "license:check": "node scripts/check-licenses.cjs",
    "security:audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "verify:fast": "npm run typecheck && npm run lint && npm run format:check && npm run arch:check && npm test",
    "verify:pr": "npm run verify:fast && npm run test:coverage && npm run test:e2e && npm run test:terminal",
    "verify:nightly": "npm run verify:pr && npm run deps:check && npm run license:check && npm run security:audit && npm run build:win",
    "verify:release": "npm run verify:nightly",
    "verify:stage0": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:terminal && npm run build:win",
    "verify:stage2": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:terminal && npm run build:win",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{ts,json,md,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" \"*.{ts,json,md,cjs}\" \"docs/**/*.md\"",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.config.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.12.0-beta.287",
    "@xterm/xterm": "^6.1.0-beta.287",
    "lucide-react": "^0.469.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
